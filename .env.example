# Copie para .env (cp .env.example .env) e troque os valores. NUNCA suba o .env para o Git.

# Banco (usado pelo container do PostgreSQL)
POSTGRES_USER=triagem
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=triagem

# Aplicação
PORT=3000
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria
CORS_ORIGIN=http://localhost:5173

# Usado só quando você roda o back-end FORA do Docker (npm run dev)
DATABASE_URL=postgres://triagem:troque-esta-senha@localhost:5432/triagem

# Operador inicial criado pelo script de seed
OPERADOR_NOME=Operador Inicial
OPERADOR_EMAIL=operador@exemplo.com
OPERADOR_SENHA=troque-esta-senha
